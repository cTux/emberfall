{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "react", "jsx-a11y"],
  "jsPlugins": [
    "@stylistic/eslint-plugin",
    "./scripts/dispatch-lint.mjs",
    "./scripts/magic-values-lint.mjs"
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true,
    "maxWarnings": 0,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "emberfall-values/named-values": "error",
    "emberfall/prefer-dispatch": "error",
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "*",
        "next": ["function", "return", "throw", "for", "switch", "if"]
      },
      { "blankLine": "always", "prev": ["function", "block-like"], "next": "*" }
    ],
    "@stylistic/lines-between-class-members": [
      "error",
      {
        "enforce": [
          { "blankLine": "always", "prev": "method", "next": "*" },
          { "blankLine": "always", "prev": "*", "next": "method" }
        ]
      }
    ],
    "typescript/no-explicit-any": "error",
    "no-unused-vars": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/consistent-type-imports": [
      "error",
      { "fixStyle": "inline-type-imports", "disallowTypeAnnotations": false }
    ],
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-base-to-string": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "eslint/prefer-const": "error",
    "eslint/no-var": "error",
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    "eslint/max-lines": ["error", { "max": 249, "skipBlankLines": true }],
    "react/react-in-jsx-scope": "off",
    "eslint/no-debugger": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-autofocus": [
      "error",
      {
        "ignoreNonDOM": true
      }
    ],
    "eslint/no-eval": "error",
    "eslint/no-implied-eval": "error",
    "eslint/curly": ["error", "all"],
    "eslint/arrow-body-style": ["error", "always"],
    "unicorn/switch-case-braces": ["error", "always"]
  },
  "ignorePatterns": ["**/dist/**", "**/build/**", "**/coverage/**"],
  "overrides": [
    {
      "files": ["packages/client/src/rendering/pixi-context.ts"],
      "rules": {
        "eslint/max-lines": ["error", { "max": 260, "skipBlankLines": true }]
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-floating-promises": [
          "error",
          {
            "allowForKnownSafeCalls": [
              {
                "from": "package",
                "package": "node:test",
                "name": ["test", "it", "describe"]
              }
            ]
          }
        ]
      }
    }
  ]
}
