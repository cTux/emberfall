{
  "name": "emberfall",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm https:setup && turbo dev --filter=@emberfall/client --filter=@emberfall/server",
    "build": "turbo build --filter=@emberfall/client --filter=@emberfall/server --filter=@emberfall/ui",
    "start": "pnpm https:setup && pnpm build && pnpm --filter @emberfall/server start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && stylelint \"packages/client/src/**/*.scss\"",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "node --test --test-concurrency=1 packages/server/src/*.test.ts tests/*.test.ts",
    "test:images": "node --test packages/client/image-optimization.test.ts",
    "test:browser": "playwright test",
    "https:setup": "pwsh -NoProfile -File scripts/setup-https.ps1",
    "benchmark": "node packages/server/scripts/benchmark.ts",
    "benchmark:runtime": "node packages/server/scripts/runtime-benchmark.ts",
    "import-save": "node --env-file-if-exists=.env --env-file-if-exists=packages/server/.env packages/server/scripts/import-save.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2004",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.7.0"
}
