{
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT_NEW",
        "SAVE_PATH_NEW",
        "STEAM_ORIGIN",
        "STEAM_WEB_API_KEY",
        "CLIENT_URL",
        "BASE_API",
        "BASE_PORT"
      ]
    },
    "build": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["BASE_API", "BASE_PORT", "PAGES_BASE_PATH", "VITE_SERVER_URL"]
    }
  }
}
